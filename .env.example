# Supabase Configuration (root web app)
# Local-only Supabase — run `supabase start` then `supabase status` to get these values.
# See SUPABASE-SETUP.md. There is no hosted/linked project for this repo.

VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=your-local-anon-key
SUPABASE_SERVICE_KEY=your-local-service-role-key

# Admin bootstrap (used by scripts/setup-all.ts and scripts/supabase-admin-setup.ts)
# ADMIN_EMAIL/ADMIN_PASSWORD are required — the scripts refuse to run if either is
# missing. No defaults are provided. ADMIN_PASSWORD must be >= 12 characters and not
# on the server-side common-password blocklist.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# ORG_NAME is optional (defaults to "Zyndio") - name for the first organization,
# only used if one doesn't already exist.
ORG_NAME=

# Flutter app build-time config (see flutter_app/dart_defines.example.json for --dart-define keys)
