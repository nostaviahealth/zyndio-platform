# Supabase Configuration (root web app)
# Get these from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api

VITE_SUPABASE_URL=https://YOUR-ZYNDIO-DEV-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key

# Admin bootstrap (used by scripts/setup-all.ts and scripts/supabase-admin-setup.ts)
# Both are required — the scripts refuse to run if either is missing. No defaults are provided.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Flutter app build-time config (see flutter_app/dart_defines.example.json for --dart-define keys)
