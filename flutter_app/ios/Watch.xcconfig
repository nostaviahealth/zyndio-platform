// [Zyndio] Professional SDK Firewall
// Apple team ID: set once in Flutter/Team.xcconfig (TC-021).
#include "Flutter/Team.xcconfig"
SDKROOT = watchos
SUPPORTED_PLATFORMS = watchos watchsimulator
TARGETED_DEVICE_FAMILY = 4
PRODUCT_BUNDLE_PACKAGE_TYPE = APPL
PRODUCT_BUNDLE_IDENTIFIER = com.zyndio.app.watchkitapp
ASSETCATALOG_COMPILER_APPICON_NAME = BrandIcon
WATCHOS_DEPLOYMENT_TARGET = 9.0
ONLY_ACTIVE_ARCH = YES
GENERATE_INFOPLIST_FILE = YES
INFOPLIST_KEY_WKCompanionAppBundleIdentifier = com.zyndio.app
INFOPLIST_KEY_WKRunsIndependentlyOfCompanionApp = YES
INFOPLIST_KEY_CFBundleDisplayName = Zyndio
SWIFT_VERSION = 5.0

// Version Sync
MARKETING_VERSION = $(FLUTTER_BUILD_NAME)
CURRENT_PROJECT_VERSION = $(FLUTTER_BUILD_NUMBER)
